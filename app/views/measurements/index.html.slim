article.auth
  h1 Замеры

  section
    h2 Вес
    = render "form", measurement: @weight
    = render "chart", chart: @chart
    ul id="weight_measurements"
      = render @weights

  section
    h2 Талия
    = render "form", measurement: @waist
    p
      small Натощак, утром, раз в неделю.
    ul id="waist_measurements"
      = render @waists
